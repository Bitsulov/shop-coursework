DB_HOST=postgres
DB_PORT=5432
DB_NAME=shop
DB_USERNAME=shop
DB_PASSWORD=shop-ci-password

S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_URL=http://localhost/storage
S3_USERNAME=shop-ci
S3_PASSWORD=shop-ci-password
S3_BUCKETNAME=shop-files

RABBIT_MQ_HOST=rabbitmq
RABBIT_MQ_USERNAME=shop
RABBIT_MQ_PASSWORD=shop-ci-password
RABBIT_MQ_VHOST=/

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=shop
MAIL_PASSWORD=shop-ci-password
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_SECRET_KEY=ci-jwt-secret-key-at-least-32-bytes-long
JWT_ACCESS_TIME=900000
JWT_REFRESH_TIME=2592000000

SWAGGER_ENABLED=true

PGADMIN_EMAIL=admin@shop.local
PGADMIN_PASSWORD=shop-ci-password
