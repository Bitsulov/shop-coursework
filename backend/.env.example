DB_HOST=example-db-host
DB_PORT=example-db-port
DB_NAME=shop
DB_USERNAME=example-db-username
DB_PASSWORD=example-db-password

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_USERNAME=example-s3-username
S3_PASSWORD=example-s3-password
S3_BUCKETNAME=shop-files

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

JWT_SECRET_KEY=example-jwt-secret-key-at-least-32-bytes-long
JWT_ACCESS_TIME=900000
JWT_REFRESH_TIME=2592000000

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=shop@example.com
MAIL_PASSWORD=example-mail-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

RABBIT_MQ_HOST=localhost
RABBIT_MQ_USERNAME=example-rabbit-username
RABBIT_MQ_PASSWORD=example-rabbit-password
RABBIT_MQ_VHOST=/

LOG_LEVEL_SQL_BIND=INFO
LOG_LEVEL_APP=DEBUG

SWAGGER_ENABLED=false
